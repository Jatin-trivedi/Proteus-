# Proteus Agent Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit secrets.

# Manager API URL (no trailing slash)
PROTEUS_SERVER_URL=http://localhost:5000

# Agent token (received from server after registration — set automatically)
# AGENT_TOKEN=

# Polling and heartbeat intervals in seconds
HEARTBEAT_INTERVAL=30
POLL_INTERVAL=15

# Job execution timeout in seconds
JOB_TIMEOUT=300

# HTTP request timeout in seconds
HTTP_TIMEOUT=10

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional agent identity overrides (auto-detected from OS if not set)
# AGENT_HOSTNAME=
# AGENT_OS=
# AGENT_ARCH=
# AGENT_VERSION=1.0.0
