SECRET_KEY=your_super_secret_key_here
DATABASE_URL=postgresql://username:password@localhost:5432/jocky

# Require the relay's client certificate at the TLS handshake.
MTLS_REQUIRED=false
MTLS_SERVER_CERT=/run/secrets/manager-server.crt
MTLS_SERVER_KEY=/run/secrets/manager-server.key
MTLS_CLIENT_CA=/run/secrets/relay-client-ca.crt