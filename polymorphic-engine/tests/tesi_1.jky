// test_all.jky - Comprehensive test for the Jocky compiler

agent TestAgent {
    // 1. TEST: Basic variables and arithmetic
    let a = 10;
    let b = 20;
    let sum = a + b;
    let is_equal = (a == 10);

    // 2. TEST: If/Else statement
    if (is_equal) {
        print("✅ a is 10");
    } else {
        print("❌ a is not 10");
    }

    // 3. TEST: While loop (count down from 5)
    let counter = 5;
    while (counter > 0) {
        print("While count: " + pack(counter)); // pack converts int to string context
        counter = counter - 1;
    }

    // 4. TEST: For loop (count up to 3)
    for (i in 0..3) {
        print("For count: " + pack(i));
    }

    // 5. TEST: Built-in system function - Get Processes
    print("📋 Fetching processes...");
    let processes = get_processes();
    print(processes);

    // 6. TEST: Built-in system function - System Info
    print("💻 Fetching system info...");
    let sysinfo = get_system_info();
    print(sysinfo);

    // 7. TEST: Built-in system function - Network Scan
    print("🌐 Scanning network (ipconfig)...");
    let network = scan_network();
    print(network);

    // 8. TEST: Built-in system function - Registry (requires admin sometimes)
    print("📂 Reading registry (HKLM\Software)...");
    let registry = collect_registry("HKLM\Software");
    print(registry);

    // 9. TEST: Struct literal and field access (dummy/limited support)
    struct Person {
        name: "Jocky",
        age: 30
    };
    let p = Person { name: "Alice", age: 25 };
    print("Struct field access: " + pack(p.age));

    // 10. TEST: User-defined function call
    let result = myHelper(42);
    print("Function result: " + result);

    // 11. Return the final summary
    return "✅ All tests executed successfully!";
}

// User-defined function (must return a string)
func myHelper(num) {
    let doubled = num * 2;
    return "Double of " + pack(num) + " is " + pack(doubled);
}